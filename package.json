{
  "name": "dsh-model-router-gateway",
  "version": "1.1.0",
  "description": "DSH 全模型顺序降级路由，经 OpenAI 兼容网关对外暴露（BaseURL + Key）。",
  "homepage": "https://www.npmjs.com/package/dsh-model-router-gateway",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fanchenjun0604/dsh-model-router-gateway.git"
  },
  "bugs": {
    "url": "https://github.com/fanchenjun0604/dsh-model-router-gateway/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "model-routing",
    "fallback",
    "failover",
    "openai-compatible",
    "gateway",
    "llm",
    "plugin"
  ],
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs/*.md",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": ">=3.18.1 <4"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "engines": {
    "node": ">=18"
  }
}
